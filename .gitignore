.venv/
__pycache__/
*.pyc
.pytest_cache/

# Patient-level data and raw parquet files stay out of git version control
data/raw/*
data/raw/*/*
data/raw/*/*/*
data/processed/*
models/*.joblib

# Explicit tracked exceptions
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!data/raw/Cardiovascular_Disease_Dataset.csv
